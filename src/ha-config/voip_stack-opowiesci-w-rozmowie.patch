+async def _handle_odtworz_w_rozmowie_service(call: ServiceCall):
+    """LATKA LECHA (15.09.2026): opowiesc torem trwajacej rozmowy z asystentem.
+
+    Szukamy sesji Assist (rozmowa robota z HA) i oddajemy jej adres pliku. Bez
+    aktywnej rozmowy zglaszamy blad, zeby skrypt w HA mogl zagrac gdzie indziej,
+    zamiast udawac sukces.
+    """
+    from homeassistant.exceptions import ServiceValidationError
+
+    from .assist_runtime import AssistMediaSession
+
+    registry = _call_registry(call.hass)
+    call_id = str(call.data.get("call_id") or "").strip()
+    sesje = [
+        (cid, relay)
+        for cid, relay in registry.relays.items()
+        if isinstance(relay, AssistMediaSession)
+        and not relay.closed.is_set()
+        and (not call_id or cid == call_id)
+    ]
+    if not sesje:
+        raise ServiceValidationError("Brak trwajacej rozmowy z asystentem")
+    # Najnowsza rozmowa - slownik trzyma kolejnosc wstawiania.
+    cid, sesja = sesje[-1]
+    sesja.zaplanuj_opowiesc(str(call.data["url"]), float(call.data.get("od") or 0.0))
+    return {"call_id": cid}
+
