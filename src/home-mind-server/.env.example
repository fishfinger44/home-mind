# HA Bridge Configuration

# Optional: LLM provider and model (defaults shown)
# LLM_PROVIDER=anthropic
# LLM_MODEL=claude-haiku-4-5-20251001

# Required (if LLM_PROVIDER=anthropic, the default): Anthropic API key for Claude
ANTHROPIC_API_KEY=sk-ant-api03-...

# Optional: OpenAI provider (set LLM_PROVIDER=openai to use)
# OPENAI_API_KEY=sk-...
# OPENAI_BASE_URL=https://api.openai.com/v1
# LLM_MODEL=gpt-4o-mini

# Required: Home Assistant connection
HA_URL=https://192.168.88.14:8123
HA_TOKEN=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9...

# Required: Shodh Memory connection
SHODH_URL=http://localhost:3030
# SHODH_API_KEY is auto-generated by deploy.sh for Docker deployments
SHODH_API_KEY=your-shodh-api-key

# Optional: Server configuration
PORT=3100
LOG_LEVEL=info

# Optional: Home Assistant TLS
HA_SKIP_TLS_VERIFY=true

# Optional: Memory settings
MEMORY_TOKEN_LIMIT=1500

# Optional: Conversation history storage (memory = in-memory, sqlite = persistent)
# CONVERSATION_STORAGE=memory
# CONVERSATION_DB_PATH=/data/conversations.db

# Optional: Custom system prompt (AI personality / behavioral rules)
# CUSTOM_PROMPT=You are Ava, a friendly and slightly sarcastic smart home assistant.

# Optional: how the assistant reaches the internet
#   grounding    - the model searches server-side in the same request (cheapest,
#                  Gemini only, needs a Google project WITH billing)
#   gemini_micro - our web_search tool, answered by a small grounded request on
#                  GEMINI_SEARCH_API_KEY (lets the chat run on a free-tier key)
#   searxng      - our web_search tool, answered by a SearXNG instance running
#                  on this machine: no key, no account, nothing to run out of
#   tavily/brave - our web_search tool, backed by a third-party search API
# A backend that runs out of its free allowance is skipped for the rest of the
# month and the next configured one answers instead. When none has free
# allowance left, the assistant stops searching and says so — it does not fall
# through onto a paid query. See GET /api/search/usage.
# Set this to spend money deliberately once the free allowances are gone:
# SEARCH_ALLOW_PAID=false
# WEB_SEARCH_MODE=grounding
# GEMINI_SEARCH_API_KEY=
# GEMINI_SEARCH_MODEL=gemini-3.6-flash
# TAVILY_API_KEY=
# BRAVE_API_KEY=
# Monthly allowances used to decide when to move on (0 = unmetered)
# TAVILY_MONTHLY_QUOTA=1000
# GEMINI_SEARCH_MONTHLY_QUOTA=5000
# Brave states no query allowance — it renews 5 USD of credit monthly and bills
# per thousand queries, so the allowance is derived from those two numbers.
# Set this when the Brave dashboard is configured to spend free credit only:
# running out then refuses instead of charging, so the estimated cut-off above
# is dropped and the credit is used up to Brave's own refusal.
# BRAVE_CREDIT_ONLY=false
# BRAVE_FREE_CREDIT_USD=5
# BRAVE_PRICE_PER_1K_USD=5
# BRAVE_MONTHLY_QUOTA=
# Self-hosted search (the searxng service in docker-compose.yml)
# SEARXNG_URL=http://127.0.0.1:8888
# SEARXNG_SECRET=
